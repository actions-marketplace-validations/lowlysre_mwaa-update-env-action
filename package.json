{
  "name": "mwaa-update-env-action",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that updates an Amazon MWAA environment",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.js && third-party-notices --ci --no-spinner",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=90 --test-coverage-functions=95 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-mwaa": "^3.1163.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "third-party-notices": "^0.1.0",
    "typescript": "^7.0.2"
  }
}
